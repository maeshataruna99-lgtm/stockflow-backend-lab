# stockflow-backend-lab local environment template.
# Copy to .env and fill in real per-machine values. Placeholders only:
# real credentials must never be committed (see docs/decisions/0003-demo-auth.md).

# Phase 2+ compose postgres credentials
# superuser password of the compose postgres instance
POSTGRES_SUPER_PASSWORD=

# least-privilege per-service role passwords
CATALOG_DB_PASSWORD=
WAREHOUSE_DB_PASSWORD=

# demo root account, demo/local profiles only, never production
ROOT_USERNAME=
ROOT_PASSWORD=

# image versions are pinned in compose.yaml and pom files, not overridden here
